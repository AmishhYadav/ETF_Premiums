# Copy this file to `.env` (which git ignores) and fill in the values.
# Never commit real values. `.env.example` only documents the names.

# Telegram bot used by `uv run etfp alerts`.
# 1. In Telegram, talk to @BotFather, send /newbot, and copy the token it gives you.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates in a browser and copy the number at
#    "chat":{"id": ...}. (That is your chat id; a group id starts with a minus sign.)
# `uv run etfp alerts --dry-run` prints alerts without needing either value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
